# Spotify「正在聽」小工具用（About section）。
# 複製這份成 .env.local（已被 .gitignore 的 `.env*` 規則排除，不會進版控），
# 填好三個值後 restart dev server / production server 即可生效。
# 三個值都缺任何一個時，/api/spotify/now-playing 會直接回傳 isPlaying:false，
# 前端元件不會顯示任何東西，不影響其他功能。

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# 站長後台 /admin（TODO A1）：Cloudflare Access 設好後填。沒填＝只有桌機本機進得去，外部一律 404。
# CF_ACCESS_TEAM 是 https://<team>.cloudflareaccess.com 的 <team>；AUD 在 Access application 的 Overview。
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
ADMIN_EMAIL=
# 或者只鎖 IP：逗號分隔，跟 Cloudflare 的 cf-connecting-ip 完全相同才放行（家裡的 IP：curl -s https://kbs0830.com/cdn-cgi/trace 看 ip=）
ADMIN_ALLOW_IPS=
