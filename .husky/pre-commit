# 套件在哪：正式站資料夾自己有 node_modules；git worktree（Claude 的 session worktree .claude/worktrees/<名字>、
# 部署用的乾淨副本 .live，2026-11-28 TODO C13／C14）沒有，往上層找正式站那份
root="$PWD"
while [ ! -d "$root/node_modules/typescript" ] && [ "$root" != "$(dirname "$root")" ]; do root="$(dirname "$root")"; done
# --max-arg-length：Windows 命令列上限約 8191 字，lint-staged 自動判斷會算錯（2026-11-25 一次改 150 多個檔案時「命令列太長」），分批送給 eslint
node "$root/node_modules/lint-staged/bin/lint-staged.js" --max-arg-length 4000
node "$root/node_modules/typescript/bin/tsc" --noEmit
